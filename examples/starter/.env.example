# Copy to .env (gitignored) and fill in. All of these are optional.

# Enables Postgres run logging. Unset => DB logging is silently disabled (HTML report still works).
DATABASE_URL=postgres://user:pass@localhost:5432/qa

# Which environment this run targets — stored on every qa.runs row.
QA_ENV=local

# Force DB logging on/off regardless of qa.config.ts (env wins).
# QA_DB_LOGGING=0

# Base URL under test (consumed by playwright.config.ts).
BASE_URL=http://localhost:3000

# Run metadata — auto-derived from git if unset. CI_RUN_URL is auto-detected on GitHub Actions.
# QA_BRANCH=
# QA_COMMIT_SHA=
# CI_RUN_URL=
